# Copy this file to .env and add your own key locally.
# Never commit .env or paste a real key into GitHub.
GROQ_API_KEY=
GEMINI_API_KEY=
THAARA_GESTURES=0
AI_MODE=auto
# Optional free local AI: install Ollama, download a model, then set this.
OLLAMA_MODEL=
# Optional offline speech: path to an extracted Vosk model directory.
VOSK_MODEL_PATH=
VOICE_MODE=auto
THAARA_WAKE_WORD=1
THAARA_TTS=1
# auto selects an installed female system voice (Friday-style sci-fi assistant feel).
THAARA_VOICE=auto
THAARA_VOICE_RATE=178
